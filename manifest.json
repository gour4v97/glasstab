{
  "manifest_version": 3,
  "name": "GlassTab — Comet-style New Tab",
  "short_name": "GlassTab",
  "version": "1.0.0",
  "description": "A Comet-inspired glassmorphism new tab: AI-first search bar, frosted-glass cards, quick links, weather and deep customization.",
  "permissions": ["storage", "topSites", "favicon", "bookmarks"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
